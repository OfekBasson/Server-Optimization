# Backend
DATABASE_URL=postgresql+psycopg2://canvas_lab:canvas_lab@localhost:5432/canvas_lab
AGENT_API_KEY=change-me
SESSION_SECRET_KEY=change-me-too

# Which origin(s) the frontend is served from - only these are allowed to
# call the API from a browser (CORS). Comma-separate for more than one.
CORS_ORIGINS=http://localhost:5173

# Twilio WhatsApp. NOTIFICATIONS_ENABLED must be true, on top of real
# Twilio credentials below, for anything to actually be sent - leave it
# false (the default) to keep every notification going to the log only.
NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Idle / staleness thresholds
IDLE_THRESHOLD_MINUTES=120
IDLE_GPU_UTIL_PERCENT_THRESHOLD=5
STALE_RESERVATION_DAYS=5
NUDGE_COOLDOWN_HOURS=12
SCHEDULER_INTERVAL_MINUTES=15
AGENT_POLL_INTERVAL_MINUTES=15
