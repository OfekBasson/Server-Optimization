# Copy this to `.env` in the deploy directory on the server itself
# (docker compose reads .env automatically) - never commit the real one.

# The DuckDNS (or other) domain this is served at, e.g. canvaslab.duckdns.org
DOMAIN=

# Random strings - generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET_KEY=
AGENT_API_KEY=

# Twilio WhatsApp - leave NOTIFICATIONS_ENABLED=false until you're ready to
# actually send messages; everything still gets logged either way.
NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
