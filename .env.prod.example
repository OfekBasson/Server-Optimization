# Copy this to `.env` in the deploy directory on the server itself
# (docker compose reads .env automatically) - never commit the real one.

# The public HTTPS address this is served at, once Tailscale Funnel is on -
# e.g. canvaslab.tailnet-name.ts.net. Only used for the backend's
# CORS_ORIGINS check; find the real value by running `tailscale funnel status`
# on the server after setup.
DOMAIN=

# Random strings - generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET_KEY=
AGENT_API_KEY=

# Twilio WhatsApp - leave NOTIFICATIONS_ENABLED=false until you're ready to
# actually send messages; everything still gets logged either way.
NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
